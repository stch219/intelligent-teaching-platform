<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- ============================================================================
     【功能】任务分配 Mapper 映射文件（表 te_task_assign，联查任务/小组信息）
     ============================================================================ -->
<mapper namespace="com.ruoyi.teach.mapper.TeTaskAssignMapper">

    <!-- 结果映射（含联查展示字段） -->
    <resultMap type="TeTaskAssign" id="TeTaskAssignResult">
        <id     property="id"         column="id"          />
        <result property="taskId"     column="task_id"     />
        <result property="groupId"    column="group_id"    />
        <result property="assignTime" column="assign_time" />
        <result property="taskCode"   column="task_code"   />
        <result property="taskName"   column="task_name"   />
        <result property="classId"    column="class_id"    />
        <result property="groupName"  column="group_name"  />
        <result property="groupOrder" column="group_order" />
    </resultMap>

    <!-- 批量新增分配记录 -->
    <insert id="batchInsert" parameterType="java.util.List">
        insert into te_task_assign (task_id, group_id, assign_time) values
        <foreach collection="list" item="item" separator=",">
            (#{item.taskId}, #{item.groupId}, #{item.assignTime})
        </foreach>
    </insert>

    <!-- 删除某任务的全部分配 -->
    <delete id="deleteByTaskId" parameterType="Long">
        delete from te_task_assign where task_id = #{taskId}
    </delete>

    <!-- 删除小组集合在其它任务上的分配（保证一组只领一个任务） -->
    <delete id="deleteByGroupIdsExceptTask">
        delete from te_task_assign
        where task_id != #{taskId}
          and group_id in
        <foreach collection="groupIds" item="gid" open="(" separator="," close=")">
            #{gid}
        </foreach>
    </delete>

    <!-- 查询班级下全部分配视图（组→任务） -->
    <select id="selectByClassId" parameterType="Long" resultMap="TeTaskAssignResult">
        select a.id, a.task_id, a.group_id, a.assign_time,
               t.task_code, t.task_name, t.class_id,
               g.group_name, g.group_order
        from te_task_assign a
        join te_task t on t.id = a.task_id
        join te_group g on g.id = a.group_id
        where t.class_id = #{classId}
        order by g.group_order
    </select>

    <!-- 统计班级下分配记录数 -->
    <select id="countByClassId" parameterType="Long" resultType="int">
        select count(1) from te_task_assign a
        join te_group g on g.id = a.group_id
        where g.class_id = #{classId}
    </select>

    <!-- 删除班级下全部分配记录 -->
    <delete id="deleteByClassId" parameterType="Long">
        delete a from te_task_assign a
        join te_task t on t.id = a.task_id
        where t.class_id = #{classId}
    </delete>

</mapper>
